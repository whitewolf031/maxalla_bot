# Telegram Bot
BOT_TOKEN=your_bot_token_here
GROUP_CHAT_ID=-1001234567890
ADMIN_IDS=123456789,987654321

# Django Backend
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=False
# Nginx yo'q, to'g'ridan-to'g'ri IP da ishlaydi - * barcha IP ga ruxsat beradi
DJANGO_ALLOWED_HOSTS=*

# Database
POSTGRES_DB=mahalla_bot
POSTGRES_USER=mahalla_user
POSTGRES_PASSWORD=strong_password_here
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Django Superuser (entrypoint.sh avtomatik yaratadi)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@mahalla.uz
DJANGO_SUPERUSER_PASSWORD=admin_password_here

# Internal API (bot va backend orasidagi maxfiy kalit)
BACKEND_URL=http://backend:8000
BACKEND_API_KEY=internal-secret-api-key
